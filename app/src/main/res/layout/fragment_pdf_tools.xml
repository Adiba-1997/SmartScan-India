<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button android:id="@+id/btn_merge" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Merge PDF" />
        <Button android:id="@+id/btn_split" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Split PDF" android:layout_marginTop="12dp"/>
        <Button android:id="@+id/btn_compress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Compress PDF" android:layout_marginTop="12dp"/>
        <Button android:id="@+id/btn_lock" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Password Lock PDF" android:layout_marginTop="12dp"/>
        <Button android:id="@+id/btn_image_to_pdf" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Image to PDF" android:layout_marginTop="12dp"/>
    </LinearLayout>
</ScrollView>
